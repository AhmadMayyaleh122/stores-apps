  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test('Response has success=true', function () {",
                  "  pm.expect(responseJson.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response has data.accessToken', function () {",
                  "  pm.expect(responseJson).to.have.nested.property('data.accessToken');",
                  "});",
                  "",
                  "if (responseJson.data && responseJson.data.accessToken) {",
                  "  pm.environment.set('adminAccessToken', responseJson.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Current Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test('Response has success=true', function () {",
                  "  pm.expect(responseJson.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response has data.admin', function () {",
                  "  pm.expect(responseJson).to.have.nested.property('data.admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Stores",
      "item": [
        {
          "name": "Create Store",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const storeSlug = `demo-store-${Date.now()}`;",
                  "pm.environment.set('createdStoreSlug', storeSlug);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test('Response has success=true', function () {",
                  "  pm.expect(responseJson.success).to.eql(true);",
                  "});",
                  "",
                  "if (responseJson.data && responseJson.data.store && responseJson.data.store.id) {",
                  "  pm.environment.set('createdStoreId', responseJson.data.store.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Demo Store\",\n  \"storeSlug\": \"{{createdStoreSlug}}\",\n  \"ownerName\": \"Demo Owner\",\n  \"ownerEmail\": \"owner@example.com\",\n  \"ownerPhone\": \"+970599000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
