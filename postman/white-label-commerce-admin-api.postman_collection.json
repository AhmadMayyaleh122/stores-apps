    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test('Response has success=true', function () {",
                  "  pm.expect(responseJson.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response has data.accessToken', function () {",
                  "  pm.expect(responseJson).to.have.nested.property('data.accessToken');",
                  "});",
                  "",
                  "if (responseJson.data && responseJson.data.accessToken) {",
                  "  pm.environment.set('adminAccessToken', responseJson.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
