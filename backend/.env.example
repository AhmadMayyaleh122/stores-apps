PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/white_label_master
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
ADMIN_JWT_EXPIRES_IN=1h

STORE_OWNER_ACTIVATION_TTL_MINUTES=1440

# Supply provisioning secrets through local or production secret management.
POSTGRES_ADMIN_URL=

TENANT_DATABASE_HOST=localhost
TENANT_DATABASE_PORT=5432
TENANT_DATABASE_SSL_MODE=disable
TENANT_POSTGRES_CONNECTION_TIMEOUT_MS=10000

TENANT_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
TENANT_CREDENTIAL_ENCRYPTION_KEY_V1=

TENANT_MIGRATION_TIMEOUT_MS=120000
