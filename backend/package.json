{
  "name": "white-label-commerce-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal NestJS API foundation for the white-label commerce backend.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build && node scripts/copy-tenant-prisma-assets.js",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:master:validate": "prisma validate --config=prisma.config.ts",
    "prisma:master:generate": "prisma generate --config=prisma.config.ts",
    "prisma:master:migrate:status": "prisma migrate status --config=prisma.config.ts",
    "prisma:master:migrate:deploy": "prisma migrate deploy --config=prisma.config.ts",
    "prisma:tenant:validate": "prisma validate --config=prisma.tenant.config.ts",
    "prisma:tenant:generate": "prisma generate --config=prisma.tenant.config.ts",
    "prisma:tenant:migrate:status": "prisma migrate status --config=prisma.tenant.config.ts",
    "prisma:tenant:migrate:deploy": "prisma migrate deploy --config=prisma.tenant.config.ts",
    "prisma:tenant:migrate:dev": "prisma migrate dev --config=prisma.tenant.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/admin-stores/**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/dto/**",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
